{
  "name": "mip",
  "version": "1.1.0",
  "description": "just because npm sucks",
  "main": "bin/mip.js",
  "bin": {
    "mip": "./bin/mip.js"
  },
  "scripts": {
    "build": "node build.js",
    "dev": "node bin/mip.js",
    "test": "npm run test:all",
    "test:all": "mocha \"test/**/*.spec.js\" --exit",
    "build:linux:x64": "node scripts/build-linux-x64.js",
    "build:linux:x86": "node scripts/build-linux-x86.js",
    "build:macos": "node scripts/build-macos.js",
    "build:windows": "node scripts/build-windows.js",
    "build:all": "npm run build:linux:x64 && npm run build:linux:x86 && npm run build:macos && npm run build:windows",
    "lint": "eslint bin/ lib/",
    "format": "prettier --write \"**/*.js\""
  },
  "dependencies": {
    "axios": "^1.16.1",
    "lru-cache": "^10.1.0",
    "semver": "^7.8.0",
    "tar": "^7.5.15"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "mocha": "^11.7.6",
    "nock": "^14.0.15",
    "pkg": "^5.8.0",
    "sinon": "^22.0.0"
  },
  "pkg": {
    "assets": [
      "lib/i18n/locales/*.json"
    ]
  }
}
