
{
  "name": "mip",
  "version": "1.1.0",
  "description": "just because npm sucks",
  "main": "bin/mip.js",
  "bin": {
    "mip": "./bin/mip.js"
  },
  "scripts": {
    "build": "node build.js",
    "dev": "node bin/mip.js",
    "test": "node tests/benchmark.js",
    "build:linux:x64": "node scripts/build-linux-x64.js",
    "build:linux:x86": "node scripts/build-linux-x86.js",
    "build:macos": "node scripts/build-macos.js",
    "build:windows": "node scripts/build-windows.js",
    "build:all": "npm run build:linux:x64 && npm run build:linux:x86 && npm run build:macos && npm run build:windows",
    "lint": "eslint bin/ lib/",
    "format": "prettier --write \"**/*.js\""
  },
  "dependencies": {
    "axios": "latest",
    "semver": "latest",
    "lru-cache": "^10.1.0",
    "react": "latest",
    "express": "latest",
    "qs": "^6.14.0",
    "side-channel": "^1.1.0",
    "es-errors": "^1.3.0",
    "object-inspect": "^1.13.4",
    "side-channel-list": "^1.0.0",
    "side-channel-map": "^1.0.1",
    "call-bound": "^1.0.2",
    "call-bind-apply-helpers": "^1.0.2",
    "function-bind": "^1.1.2",
    "get-intrinsic": "^1.3.0",
    "gopd": "^1.2.0",
    "hasown": "^2.0.2",
    "cow": "latest"
  },
  "devDependencies": {
    "pkg": "^5.8.0"
  }
}